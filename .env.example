# ===== 服务 =====
PORT=8787
HOST=0.0.0.0
NODE_ENV=production

# ===== 数据库 =====
# 连接串只放 .env（本文件是占位模板，真实值不要提交）
# 注意：sslmode=require 需要服务器启用 TLS；若本机自建库报 SSL 错误，可改 sslmode=disable
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/crypto?sslmode=require

# 只读原库 K 线表所在 schema/表（v1 只读，绝不写入）
SOURCE_SCHEMA=biz
SOURCE_TABLE=asset_klines

# 本项目写入落地的独立 schema（与原项目读写隔离）
PRACTICE_SCHEMA=practice

# 数据源标识：v1 = 币安 U 本位合约（库内已有）
DATA_SOURCE=binance_perp

# 是否在启动时自动建表（生产建议 false，由 npm run db:init 手动执行）
AUTO_INIT_DB=true

# 是否在启动时自动跑增量迁移（v6：账号维度 + 开仓设置扩展列）
# 与 AUTO_INIT_DB 分开：补列是纯增量、全幂等，漏跑会导致老库升级后登录 500。
# 生产保持 true 即可；也可关掉后手动执行 `npm run db:migrate`
AUTO_MIGRATE=true

# ===== 外部数据源出口代理（可选）=====
# 留空 = 直连。仅当数据源（币安现货 / GeckoTerminal）在本地网络不可达时设置
# 例：http://127.0.0.1:7890
FETCH_PROXY=

# ===== 启动预热 =====
# 把已登记标的提前拉进内存缓存，避免用户首访等待（跨机 DB RTT 高时收益明显）
PREWARM=true
PREWARM_LIMIT=1200
# 并发别调高：连接池 max=10，预热并发 8 会占掉 8 个连接，
# 只剩 2 个给用户请求（实测预热期间 /api/health 劣化到 4.4 秒）
PREWARM_CONCURRENCY=3

# ===== 内存缓存存活时长（毫秒）=====
# 超过后走 stale-while-revalidate：先返回旧数据，后台静默刷新，用户不卡顿
CACHE_TTL_MS=600000
